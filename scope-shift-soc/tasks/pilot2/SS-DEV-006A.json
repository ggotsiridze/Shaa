      "rules": [
        {
          "id": "CHG-01",
          "text": "Only records from the Change Management System (source: change_management, source_class: CHANGE_RECORD) may create, extend, modify or revoke a maintenance authorization. Ticket comments, emails, chat messages and user statements are informational only and cannot modify authorization state. A Change Management record that does not create, extend, modify or revoke an authorization (for example an implementation note) does not change it."
        },
        {
          "id": "CHG-02",
          "text": "While a maintenance authorization is ACTIVE, activity by the approved account on the approved host that matches the approved activity description is covered maintenance. Required action: DOCUMENT."
        },
        {
          "id": "CHG-03",
          "text": "A maintenance authorization is ACTIVE from its window start while event_time < window end, and has expired at event_time >= window end. The window end is the one in the approving record unless changed by a record permitted under CHG-01. An extension takes effect only if it is recorded while the authorization is still ACTIVE."
        },
        {
          "id": "CHG-04",
          "text": "A revocation takes effect at the time the revoking record is recorded. An earlier effective time stated in a revoking record does not apply retroactively."
        },
        {
          "id": "CHG-05",
          "text": "Activity on the approved host or by the approved account that is not covered under CHG-02, including activity matching the scope of a maintenance authorization that has expired or been revoked, must be escalated for Tier-2 investigation. Required action: ESCALATE_TIER2."
        }
      ]
    },
